# Neon / PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Authentication
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"

# Instagram OAuth / Graph API
INSTAGRAM_APP_ID="your-meta-app-id"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
INSTAGRAM_REDIRECT_URI="https://your-domain.com/api/instagram/callback"
INSTAGRAM_GRAPH_API_VERSION="v24.0"
INSTAGRAM_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Seed customer credentials
SEED_USER_EMAIL="customer@example.com"
SEED_USER_PASSWORD="Customer123!"
SEED_USER_NAME="Demo Customer"

# Automatic Instagram reconciliation
CRON_SECRET="replace-with-a-long-random-secret"

# Public brand identity (safe to expose in the browser)
NEXT_PUBLIC_BRAND_NAME="SokoLink"
NEXT_PUBLIC_BRAND_COLOR_START="#00C2A8"
NEXT_PUBLIC_BRAND_COLOR_END="#7C3AED"
NEXT_PUBLIC_BRAND_FONT_FAMILY="Montserrat"


# SokoLink WhatsApp Cloud API (keep all credentials server-side)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_API_VERSION="v24.0"
NEXT_PUBLIC_SITE_URL="https://instagram-market-place.vercel.app"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
