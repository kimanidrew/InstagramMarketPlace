generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GrowthRequestType {
  BOOST
  VERIFIED
  PRO
}

enum ProductTagType {
  PRODUCT
  CATEGORY
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum GrowthRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  requests             StoreRequest[]
  likes                ProductLike[]
  instagramConnections InstagramConnection[]
  storeReviews         StoreReview[]
  storeReviewReplies   StoreReviewReply[]
  productReviews       ProductReview[]
  growthRequests       GrowthRequest[]
  wishlistItems        WishlistItem[]
  recentlyViewedProducts RecentlyViewedProduct[]
  promotionCampaigns   PromotionCampaign[]
  aiPromotionCampaigns AiPromotionCampaign[]
  aiPromotionCreditWallet AiPromotionCreditWallet?
  aiPromotionCreditLedger AiPromotionCreditLedger[]
  notifications       Notification[]
}

model StoreRequest {
  id         String        @id @default(cuid())
  userId     String
  username   String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model InstagramConnection {
  id                String          @id
  igUserId           String          @unique
  username          String           @unique
  name              String?
  biography         String?
  profileImageUrl   String?
  profileAccentColor String?
  encryptedToken    String
  expiresAt          DateTime?
  lastSyncedAt      DateTime?
  connectedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             InstagramPost[]
  connectedBy       User?           @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  reviews           StoreReview[]
  reviewReplies     StoreReviewReply[]
  growthRequests     GrowthRequest[]
  verifiedAt        DateTime?
  verifiedUntil     DateTime?
  proUntil          DateTime?
  analyticsEvents   AnalyticsEvent[]
  promotionCampaigns PromotionCampaign[]
  aiPromotionCampaigns AiPromotionCampaign[]

  @@index([connectedByUserId])
  @@unique([connectedByUserId, igUserId])
}

model InstagramPost {
  id                    String              @id
  connectionId          String
  caption               String?
  mediaType             String
  mediaUrl              String?
  mediaItems            Json?
  thumbnailUrl          String?
  permalink             String?
  timestamp             DateTime?
  instagramLikeCount    Int                 @default(0)
  instagramCommentCount Int                 @default(0)
  isProduct             Boolean             @default(false)
  listingType           ListingType          @default(PRODUCT)
  productTitle          String?
  category              String?
  subcategory           String?
  productSlug           String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  connection             InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tags                  ProductTag[]
  likes                 ProductLike[]
  reviews               ProductReview[]
  boostUntil            DateTime?
  growthRequests        GrowthRequest[]
  analyticsEvents       AnalyticsEvent[]
  promotionCampaigns    PromotionCampaign[]
  aiPromotionCampaigns AiPromotionCampaign[]
  wishlistItems          WishlistItem[]
  recentlyViewedBy       RecentlyViewedProduct[]

  @@index([connectionId, isProduct])
}

model ProductTag {
  id     String         @id @default(cuid())
  name   String
  type   ProductTagType @default(PRODUCT)
  postId String
  post   InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([name, postId])
  @@index([name])
}

model ProductLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model StoreReview {
  id           String              @id @default(cuid())
  userId       String
  connectionId String
  rating       Int
  body         String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  replies      StoreReviewReply[]

  @@unique([userId, connectionId])
  @@index([connectionId, createdAt])
}

model StoreReviewReply {
  id           String              @id @default(cuid())
  reviewId     String
  userId       String
  connectionId String?
  body         String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  review       StoreReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([connectionId, createdAt])
}

model ProductReview {
  id        String         @id @default(cuid())
  userId    String
  postId    String
  rating    Int
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
}


model GrowthRequest {
  id           String              @id @default(cuid())
  userId       String
  connectionId String
  postId       String?
  type         String
  status       GrowthRequestStatus @default(PENDING)
  amount       Int
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post         InstagramPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  offeringId   String?
  durationDays Int                 @default(0)
  offeringName String?
  offeringFeatures String[]        @default([])
  offering     GrowthOffering?     @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([connectionId, status])
  @@index([postId, status])
}



enum AnalyticsEventType {
  IMPRESSION
  VIEW
  CLICK
}

enum PromotionTargetType {
  PRODUCT
  STORE
}

enum AiPromotionScope {
  PRODUCT
  STORE
}

enum AiPromotionMode {
  MOTION
  HYBRID
  CINEMATIC
}

enum AiPromotionStatus {
  DRAFT
  QUEUED
  PLANNING
  GENERATING
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiPromotionJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiPromotionSceneStatus {
  PENDING
  GENERATING
  READY
  FAILED
  SKIPPED
}

enum AiPromotionAssetType {
  SOURCE_IMAGE
  GENERATED_CLIP
  RENDERED_VIDEO
  THUMBNAIL
  AUDIO
  INTERMEDIATE
}

enum AiPromotionCreditEntryType {
  GRANT
  RESERVE
  CHARGE
  RELEASE
  REFUND
  ADJUSTMENT
}

enum OfferingCategory {
  PROMOTION
  GROWTH
}

enum PromotionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  connectionId String
  postId       String?
  campaignId   String?
  visitorId    String
  type         AnalyticsEventType
  createdAt    DateTime           @default(now())
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post         InstagramPost?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  campaign     PromotionCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([connectionId, type, createdAt])
  @@index([postId, type, createdAt])
  @@index([campaignId, type, createdAt])
  @@index([visitorId, createdAt])
}

model GrowthOffering {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  category    OfferingCategory
  targetType  PromotionTargetType?
  description String           @default("")
  price       Int
  targetReach Int              @default(0)
  reachMode   String           @default("FIXED")
  durationDays Int             @default(7)
  features    String[]         @default([])
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  growthRequests GrowthRequest[]
  campaigns   PromotionCampaign[]

  @@index([category, active, sortOrder])
}

model PromotionCampaign {
  id              String               @id @default(cuid())
  userId          String
  connectionId    String
  postId          String?
  targetType      PromotionTargetType
  targetReach     Int
  deliveredReach  Int                  @default(0)
  amount          Int
  status          PromotionStatus      @default(PENDING_PAYMENT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post            InstagramPost?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  payment         PromotionPayment?
  events          AnalyticsEvent[]
  offeringId      String?
  durationDays    Int                  @default(7)
  offeringName    String?
  offeringFeatures String[]             @default([])
  offering        GrowthOffering?      @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([connectionId, status])
  @@index([status, targetType])
}

model PromotionPayment {
  id                    String        @id @default(cuid())
  campaignId            String        @unique
  provider              String        @default("MPESA")
  phoneNumber           String
  amount                Int
  status                PaymentStatus @default(INITIATED)
  merchantRequestId     String?
  checkoutRequestId     String?       @unique
  receiptNumber         String?       @unique
  resultCode            String?
  resultDescription     String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  paidAt                DateTime?
  campaign              PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model WishlistItem {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}


model RecentlyViewedProduct {
  id           String        @id @default(cuid())
  userId       String
  postId       String
  lastViewedAt DateTime      @default(now())
  viewCount    Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, lastViewedAt])
  @@index([postId])
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}


// Central SokoLink WhatsApp shopping assistant conversations.
model WhatsAppConversation {
  id            String            @id @default(cuid())
  waId          String            @unique
  profileName   String?
  lastMessageAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      WhatsAppMessage[]

  @@index([lastMessageAt])
}

model WhatsAppMessage {
  id             String             @id @default(cuid())
  waMessageId    String             @unique
  conversationId String
  direction      String
  type           String             @default("text")
  body           String?
  status         String             @default("RECEIVED")
  createdAt      DateTime           @default(now())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}


// AI Promotion Studio campaigns are separate from marketplace reach/payment campaigns.
model AiPromotionCampaign {
  id              String             @id @default(cuid())
  userId          String
  connectionId    String
  postId          String?
  scope           AiPromotionScope
  mode            AiPromotionMode    @default(HYBRID)
  status          AiPromotionStatus  @default(DRAFT)
  durationSeconds Int                @default(15)
  width           Int                @default(1080)
  height          Int                @default(1920)
  frameRate       Int                @default(30)
  prompt          String             @db.Text
  sourceSnapshot  Json?
  storyboard      Json?
  outputKey       String?
  thumbnailKey    String?
  errorCode       String?
  errorMessage    String?            @db.Text
  progress        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  completedAt     DateTime?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post            InstagramPost?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  jobs            AiPromotionJob[]
  scenes          AiPromotionScene[]
  assets          AiPromotionAsset[]
  usage            AiPromotionProviderUsage[]

  @@index([userId, createdAt])
  @@index([connectionId, status, createdAt])
  @@index([status, updatedAt])
}

model AiPromotionJob {
  id              String               @id @default(cuid())
  campaignId      String
  status          AiPromotionJobStatus  @default(QUEUED)
  stage           String               @default("planning")
  attempts        Int                  @default(0)
  maxAttempts     Int                  @default(4)
  idempotencyKey  String               @unique
  leaseExpiresAt  DateTime?
  nextAttemptAt   DateTime?
  provider        String?
  providerTaskId  String?
  errorCode       String?
  errorMessage    String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  campaign        AiPromotionCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scenes          AiPromotionScene[]
  usage           AiPromotionProviderUsage[]

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([campaignId, createdAt])
  @@index([provider, providerTaskId])
}

model AiPromotionScene {
  id              String                 @id @default(cuid())
  campaignId      String
  jobId           String?
  position        Int
  startSeconds    Int
  durationSeconds Int
  title           String
  prompt          String                 @db.Text
  strategy        AiPromotionMode        @default(MOTION)
  status          AiPromotionSceneStatus @default(PENDING)
  sourceAssetKeys String[]               @default([])
  outputAssetKey  String?
  provider        String?
  providerTaskId  String?
  errorCode       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  campaign        AiPromotionCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  job             AiPromotionJob?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assets          AiPromotionAsset[]

  @@unique([campaignId, position])
  @@index([campaignId, status, position])
  @@index([provider, providerTaskId])
}

model AiPromotionAsset {
  id              String                 @id @default(cuid())
  campaignId      String
  sceneId         String?
  type            AiPromotionAssetType
  objectKey       String
  mimeType        String
  sizeBytes       BigInt?
  width           Int?
  height          Int?
  durationSeconds Float?
  metadata        Json?
  createdAt       DateTime               @default(now())

  campaign        AiPromotionCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene           AiPromotionScene?      @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@unique([campaignId, objectKey])
  @@index([campaignId, type, createdAt])
}

model AiPromotionCreditWallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  availableCredits  Int      @default(0)
  reservedCredits   Int      @default(0)
  lifetimeGranted   Int      @default(0)
  lifetimeConsumed  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger            AiPromotionCreditLedger[]
}

model AiPromotionCreditLedger {
  id              String                    @id @default(cuid())
  userId          String
  walletId        String
  campaignId      String?
  entryType       AiPromotionCreditEntryType
  amount          Int
  idempotencyKey  String                    @unique
  description     String?
  metadata        Json?
  createdAt       DateTime                  @default(now())

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          AiPromotionCreditWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([campaignId, createdAt])
}

model AiPromotionProviderUsage {
  id                String               @id @default(cuid())
  campaignId        String
  jobId             String?
  provider          String
  model             String?
  operationKey      String               @unique
  inputSeconds      Int                  @default(0)
  outputSeconds     Int                  @default(0)
  estimatedCostUsd  Decimal              @default(0) @db.Decimal(12, 6)
  actualCostUsd     Decimal?             @db.Decimal(12, 6)
  status            String               @default("ESTIMATED")
  providerRequestId String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  campaign          AiPromotionCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  job               AiPromotionJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([provider, status, createdAt])
}
