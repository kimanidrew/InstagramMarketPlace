generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GrowthRequestType {
  BOOST
  VERIFIED
  PRO
}

enum ProductTagType {
  PRODUCT
  CATEGORY
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum GrowthRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  requests             StoreRequest[]
  likes                ProductLike[]
  instagramConnections InstagramConnection[]
  storeReviews         StoreReview[]
  productReviews       ProductReview[]
  growthRequests       GrowthRequest[]
  wishlistItems        WishlistItem[]
  recentlyViewedProducts RecentlyViewedProduct[]
  promotionCampaigns   PromotionCampaign[]
  notifications       Notification[]
}

model StoreRequest {
  id         String        @id @default(cuid())
  userId     String
  username   String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model InstagramConnection {
  id                String          @id
  igUserId           String          @unique
  username          String           @unique
  name              String?
  biography         String?
  profileImageUrl   String?
  encryptedToken    String
  expiresAt          DateTime?
  lastSyncedAt      DateTime?
  connectedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             InstagramPost[]
  connectedBy       User?           @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  reviews           StoreReview[]
  growthRequests     GrowthRequest[]
  verifiedAt        DateTime?
  verifiedUntil     DateTime?
  proUntil          DateTime?
  analyticsEvents   AnalyticsEvent[]
  promotionCampaigns PromotionCampaign[]

  @@index([connectedByUserId])
  @@unique([connectedByUserId, igUserId])
}

model InstagramPost {
  id                    String              @id
  connectionId          String
  caption               String?
  mediaType             String
  mediaUrl              String?
  mediaItems            Json?
  thumbnailUrl          String?
  permalink             String?
  timestamp             DateTime?
  instagramLikeCount    Int                 @default(0)
  instagramCommentCount Int                 @default(0)
  isProduct             Boolean             @default(false)
  listingType           ListingType          @default(PRODUCT)
  productTitle          String?
  category              String?
  subcategory           String?
  productSlug           String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  connection             InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tags                  ProductTag[]
  likes                 ProductLike[]
  reviews               ProductReview[]
  boostUntil            DateTime?
  growthRequests        GrowthRequest[]
  analyticsEvents       AnalyticsEvent[]
  promotionCampaigns    PromotionCampaign[]
  wishlistItems          WishlistItem[]
  recentlyViewedBy       RecentlyViewedProduct[]

  @@index([connectionId, isProduct])
}

model ProductTag {
  id     String         @id @default(cuid())
  name   String
  type   ProductTagType @default(PRODUCT)
  postId String
  post   InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([name, postId])
  @@index([name])
}

model ProductLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model StoreReview {
  id           String              @id @default(cuid())
  userId       String
  connectionId String
  rating       Int
  body         String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, connectionId])
  @@index([connectionId, createdAt])
}

model ProductReview {
  id        String         @id @default(cuid())
  userId    String
  postId    String
  rating    Int
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
}


model GrowthRequest {
  id           String              @id @default(cuid())
  userId       String
  connectionId String
  postId       String?
  type         GrowthRequestType
  status       GrowthRequestStatus @default(PENDING)
  amount       Int
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post         InstagramPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([connectionId, status])
  @@index([postId, status])
}



enum AnalyticsEventType {
  IMPRESSION
  VIEW
  CLICK
}

enum PromotionTargetType {
  PRODUCT
  STORE
}

enum PromotionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  connectionId String
  postId       String?
  campaignId   String?
  visitorId    String
  type         AnalyticsEventType
  createdAt    DateTime           @default(now())
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post         InstagramPost?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  campaign     PromotionCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([connectionId, type, createdAt])
  @@index([postId, type, createdAt])
  @@index([campaignId, type, createdAt])
  @@index([visitorId, createdAt])
}

model PromotionCampaign {
  id              String               @id @default(cuid())
  userId          String
  connectionId    String
  postId          String?
  targetType      PromotionTargetType
  targetReach     Int
  deliveredReach  Int                  @default(0)
  amount          Int
  status          PromotionStatus      @default(PENDING_PAYMENT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post            InstagramPost?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  payment         PromotionPayment?
  events          AnalyticsEvent[]

  @@index([userId, createdAt])
  @@index([connectionId, status])
  @@index([status, targetType])
}

model PromotionPayment {
  id                    String        @id @default(cuid())
  campaignId            String        @unique
  provider              String        @default("MPESA")
  phoneNumber           String
  amount                Int
  status                PaymentStatus @default(INITIATED)
  merchantRequestId     String?
  checkoutRequestId     String?       @unique
  receiptNumber         String?       @unique
  resultCode            String?
  resultDescription     String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  paidAt                DateTime?
  campaign              PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model WishlistItem {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}


model RecentlyViewedProduct {
  id           String        @id @default(cuid())
  userId       String
  postId       String
  lastViewedAt DateTime      @default(now())
  viewCount    Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, lastViewedAt])
  @@index([postId])
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}
