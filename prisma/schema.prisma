generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GrowthRequestType {
  BOOST
  VERIFIED
  PRO
}

enum ProductTagType {
  PRODUCT
  CATEGORY
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum GrowthRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  requests             StoreRequest[]
  likes                ProductLike[]
  instagramConnections InstagramConnection[]
  storeReviews         StoreReview[]
  productReviews       ProductReview[]
  growthRequests       GrowthRequest[]
  wishlistItems        WishlistItem[]
}

model StoreRequest {
  id         String        @id @default(cuid())
  userId     String
  username   String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model InstagramConnection {
  id                String          @id
  igUserId           String          @unique
  username          String           @unique
  name              String?
  biography         String?
  profileImageUrl   String?
  encryptedToken    String
  expiresAt          DateTime?
  lastSyncedAt      DateTime?
  connectedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             InstagramPost[]
  connectedBy       User?           @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  reviews           StoreReview[]
  growthRequests     GrowthRequest[]
  verifiedAt        DateTime?
  proUntil          DateTime?

  @@index([connectedByUserId])
  @@unique([connectedByUserId, igUserId])
}

model InstagramPost {
  id                    String              @id
  connectionId          String
  caption               String?
  mediaType             String
  mediaUrl              String?
  mediaItems            Json?
  thumbnailUrl          String?
  permalink             String?
  timestamp             DateTime?
  instagramLikeCount    Int                 @default(0)
  instagramCommentCount Int                 @default(0)
  isProduct             Boolean             @default(false)
  listingType           ListingType          @default(PRODUCT)
  productTitle          String?
  category              String?
  subcategory           String?
  productSlug           String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  connection             InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tags                  ProductTag[]
  likes                 ProductLike[]
  reviews               ProductReview[]
  boostUntil            DateTime?
  growthRequests        GrowthRequest[]
  wishlistItems          WishlistItem[]

  @@index([connectionId, isProduct])
}

model ProductTag {
  id     String         @id @default(cuid())
  name   String
  type   ProductTagType @default(PRODUCT)
  postId String
  post   InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([name, postId])
  @@index([name])
}

model ProductLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model StoreReview {
  id           String              @id @default(cuid())
  userId       String
  connectionId String
  rating       Int
  body         String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, connectionId])
  @@index([connectionId, createdAt])
}

model ProductReview {
  id        String         @id @default(cuid())
  userId    String
  postId    String
  rating    Int
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
}


model GrowthRequest {
  id           String              @id @default(cuid())
  userId       String
  connectionId String
  postId       String?
  type         GrowthRequestType
  status       GrowthRequestStatus @default(PENDING)
  amount       Int
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  post         InstagramPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([connectionId, status])
  @@index([postId, status])
}


model WishlistItem {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}
